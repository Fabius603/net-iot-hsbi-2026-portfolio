        </mxCell>
        <mxCell id="adm" value="10.100.2.0/24&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;darf laut Router-Firewall SSH + ICMP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="230" height="50" as="geometry" />
