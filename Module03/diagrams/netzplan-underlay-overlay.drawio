        <mxCell id="leg1" value="&lt;b&gt;Legende&lt;/b&gt;&lt;br&gt;● rot = Verbindung verlässt hier das Gebäude&lt;br&gt;Sechseck = NAT / Firewall&lt;br&gt;gestrichelt = Beispiel, nicht gemessen" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
