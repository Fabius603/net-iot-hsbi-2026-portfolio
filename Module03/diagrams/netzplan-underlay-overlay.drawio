        <mxCell id="cl" value="Service-Hosts 10.100.1.0/24 (Cluster)" style="swimlane;html=1;startSize=26;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="280" width="300" height="330" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="ulno-oldplex01 · 10.100.1.1" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="cl"><mxGeometry x="20" y="40" width="260" height="35" as="geometry" /></mxCell>
        <mxCell id="o2" value="ulno-oldplex02 · 10.100.1.11" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="cl"><mxGeometry x="20" y="85" width="260" height="35" as="geometry" /></mxCell>
        <mxCell id="o3" value="ulno-oldplex03 · 10.100.1.12" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="cl"><mxGeometry x="20" y="130" width="260" height="35" as="geometry" /></mxCell>
        <mxCell id="o4" value="&lt;b&gt;ulno-oldplex04 · 10.100.1.13&lt;/b&gt;&lt;br&gt;unser Node-RED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="cl"><mxGeometry x="20" y="175" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="o5" value="ulno-oldplex05 · 10.100.1.14" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="cl"><mxGeometry x="20" y="235" width="260" height="35" as="geometry" /></mxCell>

        <!-- Lighthouse-Abfragen -->
        <mxCell id="q1" value="meldet sich an,&lt;br&gt;fragt nach Peers" style="endArrow=block;startArrow=block;html=1;dashed=1;strokeColor=#d6b656;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="r12" target="lh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q2" value="meldet sich an" style="endArrow=block;startArrow=block;html=1;dashed=1;strokeColor=#d6b656;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=0;" edge="1" parent="1" source="cl" target="lh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q3" style="endArrow=block;startArrow=block;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="pods" target="lh"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Tunnel -->
        <mxCell id="tun" value="&lt;b&gt;Tunnel router12 ↔ oldplex04&lt;/b&gt;&lt;br&gt;direkt nach Hole Punching&lt;br&gt;(Gegenstelle 212.201.138.168:59190)" style="endArrow=block;startArrow=block;html=1;strokeWidth=5;strokeColor=#2d7600;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="r12" target="o4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel" value="anfangs über Relay 10.100.0.1&lt;br&gt;(Log: „Send handshake via relay“)" style="endArrow=none;html=1;dashed=1;strokeWidth=2;strokeColor=#d79b00;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=orthogonalEdgeStyle;curved=1;" edge="1" parent="1" source="r12" target="lh">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="175" y="145" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="notlh" value="&lt;b&gt;Nicht auf dem Lighthouse:&lt;/b&gt;&lt;br&gt;• MQTT-Daten router12 ↔ Node-RED (nach dem Punchen direkt)&lt;br&gt;• die Node-RED-Weboberfläche&lt;br&gt;• Verkehr im Pod-LAN (Sensor → Broker)&lt;br&gt;• CA und privater Schlüssel – signiert wird beim Instructor&lt;br&gt;• Firewall-Entscheidungen – die trifft jeder Knoten selbst" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="380" y="560" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="peer" value="&lt;b&gt;Rollen&lt;/b&gt;&lt;br&gt;Knoten/Peer: hat Zertifikat + Schlüssel, eigene 10.100-Adresse&lt;br&gt;Lighthouse: kennt die aktuellen Underlay-Adressen der Peers&lt;br&gt;Zertifikat: Name, Adresse, Gruppen – signiert von der Klassen-CA&lt;br&gt;Ping- und Durchsatzmessungen: siehe Aufgabe 5" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="720" width="560" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

